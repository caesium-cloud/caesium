// DIAG ONLY (never merged). ARG is replaced with "args->" or "args." to suit
// the runner's bpftrace. Paths of container cgroups carry the container ID.
tracepoint:oom:mark_victim
{
    printf("T %llu victim pid=%d\n", nsecs, ARGpid);
}
tracepoint:cgroup:cgroup_notify_populated
{
    printf("T %llu populated=%d id=%llu by=%s path=%s\n", nsecs, ARGval, ARGid, comm, STR(ARGpath));
}
tracepoint:cgroup:cgroup_rmdir
{
    printf("T %llu rmdir id=%llu by=%s pid=%d path=%s\n", nsecs, ARGid, comm, pid, STR(ARGpath));
}
tracepoint:syscalls:sys_enter_openat
/comm == "containerd-shim" || comm == "conmon"/
{
    printf("T %llu openat by=%s tid=%d file=%s\n", nsecs, comm, tid, STR(ARGfilename));
}
tracepoint:syscalls:sys_exit_openat
/comm == "containerd-shim" || comm == "conmon"/
{
    printf("T %llu openret by=%s tid=%d ret=%d\n", nsecs, comm, tid, ARGret);
}
