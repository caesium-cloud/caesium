#!/bin/sh
# Rendered by app-web's main.tf through templatefile(). This file is NOT
# Terraform configuration: it matches none of the *.tf / *.tfvars / lock globs,
# and it lives in a subdirectory. Editing it changes what the stack deploys
# without touching a single .tf file, which is exactly the shape a fingerprint
# built from configuration extensions alone could not see.
echo "app-web bootstrap for ${vpc_id}"
