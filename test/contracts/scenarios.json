        "DT-ADMIT-01",
        "DT-OWNER-01",
        "DT-DAG-01",
        "DT-RECOVER-01"
      ],
      "status": "proven",
      "owner_item": "B1",
      "registered_by": "G3",
      "gates": [
        "early"
      ],
      "notes": "Executed by `just robustness-test` (scripts/robustness.sh) on a kind cluster of 1 control-plane + 3 worker nodes with three persistent Helm StatefulSet replicas. Observed topology, mode and flags are read back from the running pods; the fault and recovery evidence comes from the retained recorder records, not from the test's exit status alone.",
      "topology": {
        "kind": "kind-helm-statefulset",
        "replicas": 3,
        "persistence": true,
        "engine": "kubernetes",
