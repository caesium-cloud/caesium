      "name": "Owner crash while the owner is the dqlite leader",
      "selector": "TestOwnerCrash/owner_is_leader",
      "contract_ids": [
        "DT-ADMIT-01",
        "DT-OWNER-01",
        "DT-DAG-01",
        "DT-RECOVER-01"
      ],
      "status": "absent",
      "owner_item": "B1",
      "registered_by": "G3",
      "gates": [],
      "notes": "Planned B1 regression. G3 registers the selector and early gate after B1 exists; not proven.",
      "topology": {
        "kind": "kind-helm-statefulset",
        "replicas": 3,
        "persistence": true,
        "engine": "kubernetes",
        "control_plane_nodes": 1,
        "worker_nodes": 3,
        "voters": 3,
        "standbys": 0,
        "database_shards": 1
      },
      "mode": {
        "execution": "distributed",
        "owner": "enabled",
        "surface": "http"
      },
      "feature_flags": {
        "CAESIUM_EXECUTION_MODE": "distributed",
        "CAESIUM_RUN_OWNER_ENABLED": "true",
        "CAESIUM_RUN_OWNER_IN_MEMORY": "true",
        "CAESIUM_DATABASE_SHARDS": "1",
        "CAESIUM_DATABASE_VOTERS": "3",
        "CAESIUM_DATABASE_STANDBYS": "0",
        "CAESIUM_DATABASE_CONSOLE_ENABLED": "true",
        "kubernetes.engine.enabled": "true",
        "run_lease_ttl": "30s",
        "dispatch_interval": "1s",
        "worker_lease_ttl": "30s",
        "reclaim_interval": "1s",
        "worker_pool_size": "2"
      },
      "expected_observations": [
        {
          "id": "http_202_with_run_uuid",
          "description": "POST /v1/jobs/:id/run returns 202 with a run body and UUID."
        },
        {
          "id": "run_uuid_publicly_readable_after_fault",
          "description": "The acknowledged run UUID remains publicly readable after the owner SIGKILL."
        },
        {
          "id": "run_uuid_bound_to_same_job",
          "description": "The acknowledged run UUID does not become a different job."
        },
        {
          "id": "authoritative_lease_generation_increased",
          "description": "Exactly one authoritative lease row is observed with a new surviving owner and increasing generation."
        },
        {
          "id": "surviving_owner_completed_same_run",
          "description": "A surviving owner finishes the same accepted run."
        },
        {
          "id": "legal_successors_executed",
          "description": "Legal DAG successors execute after the blocked predecessor completes."
        },
        {
          "id": "public_state_matches_raw_effects",
          "description": "Final public state agrees with the recorder's raw starts and completions."
        },
        {
          "id": "restarted_member_rejoined_retained_volume",
          "description": "The restarted old member rejoins with its retained volume."
        },
        {
          "id": "three_dqlite_voters_and_leader",
          "description": "Three distinct dqlite voters and an agreed leader are observed before the fault."
        },
        {
          "id": "fixture_task_on_surviving_worker",
          "description": "Every pre-fault fixture task pod is placed on a surviving worker."
        }
      ],
      "allowed_skips": [],
      "evidence": {
        "require_candidate_sha": true,
        "require_candidate_digest": true,
        "require_recorder": true,
        "artifact_identity": "robustness-owner-crash",
        "min_samples": 1
      },
      "fault_activation": {
        "required": true,
        "kind": "owner-sigkill",
        "required_observations": [
          "owner_kind_node_cordoned_before_fixture",
          "owner_container_sigkill",
          "process_exit_before_sink_barrier_release",
          "kubelet_stopped_during_survivor_takeover"
        ]
      }
    },
