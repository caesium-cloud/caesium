{
  "realm": "caesium",
  "displayName": "Caesium Keycloak lane (test fixture only)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultDefaultClientScopes": ["basic", "profile", "email"],
  "defaultOptionalClientScopes": ["groups"],
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for the sub and auth_time claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "description": "Group membership as a flat groups claim (full group path off)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "caesium",
      "name": "Caesium",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "caesium-keycloak-lane-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://127.0.0.1:8080/auth/sso/oidc/callback"],
      "webOrigins": ["http://127.0.0.1:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": ["groups"]
    }
  ],
  "groups": [
    { "name": "caesium-admins" },
    { "name": "marketing-eng" },
    { "name": "finance-eng" },
    { "name": "kc-matrix-viewer-default" },
    { "name": "kc-matrix-viewer-marketing" },
    { "name": "kc-matrix-viewer-finance" },
    { "name": "kc-matrix-viewer-all" },
    { "name": "kc-matrix-runner-default" },
    { "name": "kc-matrix-runner-marketing" },
    { "name": "kc-matrix-runner-finance" },
    { "name": "kc-matrix-runner-all" },
    { "name": "kc-matrix-operator-default" },
    { "name": "kc-matrix-operator-marketing" },
    { "name": "kc-matrix-operator-finance" },
    { "name": "kc-matrix-operator-all" },
    { "name": "kc-matrix-admin-default" },
    { "name": "kc-matrix-admin-marketing" },
    { "name": "kc-matrix-admin-finance" },
    { "name": "kc-matrix-admin-all" }
  ],
  "users": [
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "kc-lane-admin-password", "temporary": false }],
      "groups": ["/caesium-admins"]
    },
    {
      "username": "bob@example.com",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Marketing",
      "credentials": [{ "type": "password", "value": "kc-lane-bob-password", "temporary": false }],
      "groups": ["/marketing-eng"]
    },
    {
      "username": "carol@example.com",
      "email": "carol@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Unbound",
      "credentials": [{ "type": "password", "value": "kc-lane-carol-password", "temporary": false }],
      "groups": []
    },
    {
      "username": "dave@example.com",
      "email": "dave@example.com",
      "emailVerified": false,
      "enabled": true,
      "firstName": "Dave",
      "lastName": "Unverified",
      "credentials": [{ "type": "password", "value": "kc-lane-dave-password", "temporary": false }],
      "groups": []
    },
    {
      "username": "erin@example.com",
      "email": "erin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Erin",
      "lastName": "Verified",
      "credentials": [{ "type": "password", "value": "kc-lane-erin-password", "temporary": false }],
      "groups": []
    }
  ]
}
