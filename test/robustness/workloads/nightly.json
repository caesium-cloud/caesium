{
  "profile": "nightly",
  "description": "Scheduled form (30-60 min): the same mandatory pass, then seeded uniform family draws while CAESIUM_SOAK_DURATION lasts, with heavier mixes, extra kills including leader-only kills, and repeated replacements.",
  "schedule_budget": "30m",
  "max_episodes": 60,
  "heal_progress_bound": "120s",
  "run_bound": "240s",
  "background": {
    "trickle_interval_ms": [3000, 6000],
    "hold_seconds": 1
  },
  "slow_consumers": {
    "consumers": [3, 6],
    "read_delay_ms": [200, 1500],
    "chunk_bytes": 256,
    "burst_runs": [6, 12],
    "hold_seconds": [1, 3],
    "goroutine_slack": 60,
    "settle_bound": "90s"
  },
  "queue_overload": {
    "low": [6, 12],
    "high": [3, 6],
    "hold_seconds": [1, 2]
  },
  "retention": {
    "burst_runs": [15, 30],
    "long_steps": [8, 12],
    "long_step_seconds": [2, 3],
    "keep_fulls": 3,
    "trigger_parallelism": 6
  },
  "repeated_failover": {
    "mandatory_kinds": ["owner_is_leader", "owner_is_not_leader"],
    "extra_kinds": ["leader_only", "owner_is_not_leader", "owner_is_leader"],
    "extra_kills": [0, 2],
    "recovery_bound": "120s",
    "rejoin_bound": "240s"
  },
  "node_replacement": {
    "replacements": [1, 2],
    "rejoin_bound": "300s"
  },
  "drain": {
    "bound": "10m",
    "settle": "60s",
    "samples": 4,
    "sample_interval": "30s",
    "container_grace": "180s"
  }
}
